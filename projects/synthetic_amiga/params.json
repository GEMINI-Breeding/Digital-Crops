      "lookat_offset_y": { "sampling": "uniform", "min": -0.3, "max": 0.3 },
      "lookat_offset_z": { "sampling": "uniform", "min": 0.0, "max": 0.5 }
    }

  },

  "radiationmodel": {

    "colorboard": "plugins/radiation/spectral_data/color_board/DGK_DKK_colorboard.xml",
    
    "leaf_surface_spectral_data": {
      "file": "plugins/radiation/spectral_data/leaf_surface_spectral_library.xml",
