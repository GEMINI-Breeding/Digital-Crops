      "2  POLYGON ((-121.77762 38.53639, -121.77763 38.5...  \n",
      "3  POLYGON ((-121.77764 38.53639, -121.77765 38.5...  \n",
      "4  POLYGON ((-121.77766 38.53639, -121.77767 38.5...  \n"
     ]
    }
   ],
   "source": [
    "# Load the GeoJSON with plot boundaries\n",
    "gdf = gpd.read_file(geojson_path)\n",
    "print(f\"Loaded {len(gdf)} plots from GeoJSON\")\n",
    "print(f\"CRS: {gdf.crs}\")\n",
    "print(f\"Columns: {gdf.columns.tolist()}\")\n",
    "print(f\"\\nFirst few rows:\")\n",
    "print(gdf.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8d4efc02",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Ortho CRS: EPSG:4326\n",
      "Ortho bounds: BoundingBox(left=-121.77884658276166, bottom=38.53625616047701, right=-121.77752918419036, top=38.53701842018201)\n",
      "Ortho shape: (12175, 16527)\n",
      "Ortho resolution: (7.971190000014639e-08, 6.260859999989889e-08)\n"
     ]
    }
   ],
   "source": [
    "# Load the drone orthophoto\n",
    "with rasterio.open(ortho_path) as src:\n",
    "    ortho_crs = src.crs\n",
    "    ortho_bounds = src.bounds\n",
    "    ortho_transform = src.transform\n",
    "    ortho_shape = (src.height, src.width)\n",
    "    \n",
    "    print(f\"Ortho CRS: {ortho_crs}\")\n",
    "    print(f\"Ortho bounds: {ortho_bounds}\")\n",
    "    print(f\"Ortho shape: {ortho_shape}\")\n",
    "    print(f\"Ortho resolution: {src.res}\")\n",
    "    \n",
    "    # Reproject GeoJSON to match ortho CRS if needed\n",
    "    if gdf.crs != ortho_crs:\n",
    "        print(f\"Reprojecting GeoJSON from {gdf.crs} to {ortho_crs}\")\n",
    "        gdf = gdf.to_crs(ortho_crs)\n",
    "    \n",
    "    # Read a downsampled version for overview (every 10th pixel)\n",
    "    ortho_overview = src.read([1, 2, 3], out_shape=(3, src.height // 10, src.width // 10))\n",
    "    ortho_overview = np.moveaxis(ortho_overview, 0, -1)  # Move channels to last dimension"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "6c040719",
   "metadata": {},
   "outputs": [
    {
     "data": {
