   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Processing real orthophoto data (bottom rows)...\n",
      "  Processing: 2025-06-06-11:05:21-RGB.tif -> DAP 10\n",
      "  Processing: 2025-06-24-09:47:51-RGB.tif -> DAP 28\n",
      "  Processing: 2025-07-15-09:48:12-RGB.tif -> DAP 49\n",
      "  Processing: 2025-08-05-09:27:97-RGB.tif -> DAP 70\n",
      "  Processing: 2025-08-22-11:07:12-RGB.tif -> DAP 87\n",
      "\n",
      "Processing synthetic data (top rows)...\n"
     ]
